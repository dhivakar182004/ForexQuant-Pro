# Backend Environment Variables Template
DB_URL=jdbc:mysql://<your-db-host>:3306/forexquant
DB_USERNAME=root
DB_PASSWORD=yourpassword
DB_DRIVER=com.mysql.cj.jdbc.Driver
DB_DIALECT=org.hibernate.dialect.MySQLDialect

# Security
JWT_SECRET=your-very-secure-secret-key-at-least-64-characters
TOTP_APP_SECRET=your-totp-secret-key

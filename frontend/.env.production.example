# Production Vercel Environment Variables
# Copy these into the Vercel Dashboard Settings > Environment Variables

# REPLACE with your backend domain (e.g., https://forexquant-backend.render.com)
VITE_API_BASE_URL=https://YOUR_BACKEND_URL

# REPLACE with your secure websocket domain (e.g., wss://forexquant-backend.render.com/ws-forex)
VITE_WS_URL=wss://YOUR_BACKEND_URL/ws-forex

# OPTIONAL: Chart Replay Speed (e.g., 2)
VITE_REPLAY_SPEED=1
